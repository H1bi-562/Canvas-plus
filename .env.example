DATABASE_URL=example-postgress-connection-url

BETTER_AUTH_SECRET=example-thirty-two-character-string
BETTER_AUTH_URL=http://localhost:3000

# Canvas token encryption: 64 hexadecimal characters, separate from the auth secret.
ENCRYPTION_KEY=
CANVAS_BASE_URL=https://canvas.instructure.com

# Optional OAuth developer credentials. Personal access tokens do not need these.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:3000/api/canvas/callback
CANVAS_SCOPES=

# Optional Google Calendar import (read-only). Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Explicit disposable database for integration checks. Never defaults to DATABASE_URL.
TEST_DATABASE_URL=
# Public extension setting: put in apps/extension/.env or export before building.
WXT_WEB_APP_URL=http://localhost:3000
