#Canvas LMS
#Personal access tokens (POST /api/canvas/token) need only CANVAS_BASE_URL,
#e.g. https://csulb.instructure.com. OAuth2 also needs the client id, secret and
#redirect URI from a developer key.
#Development: a local Canvas instance where you are admin and can issue a
#developer key. Production: https://csulb.instructure.com once IT grants access.
CANVAS_BASE_URL=http://localhost:3001
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:3000/api/canvas/callback
#Optional. Leave empty unless the developer key enforces scopes.
CANVAS_SCOPES=

#Where the API redirects the browser after the OAuth round trip
FRONTEND_URL=http://localhost:5173

#AES-256-GCM key encrypting Canvas tokens at rest.
#Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
