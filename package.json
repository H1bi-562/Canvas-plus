{
  "name": "canvasplus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev --filter=@canvasplus/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "pnpm --filter @canvasplus/database test:integration && pnpm --filter @canvasplus/auth test:integration && pnpm --filter @canvasplus/web test:integration",
    "db:generate": "pnpm --filter @canvasplus/database db:generate",
    "db:migrate": "pnpm --filter @canvasplus/database db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.8.0"
  }
}
